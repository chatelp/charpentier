# Copy to infra/.env (never committed) and fill in.
# A long random password: openssl rand -base64 32
POSTGRES_PASSWORD=change-me
# The public address of the server (DNS to the host, through its Traefik).
CHARPENTIER_HOST=charpentier.example.org
# Where the nightly backups of the database go on the host.
BACKUP_ARCHIVE=/srv/backups/charpentier
# Traefik of the host: its Docker network, entry point and certificate resolver.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=cloudflare
# Build context of the server image: ../apps/server in the repository,
# ./server in a copy made by scripts/deploy-server.sh.
SERVER_CONTEXT=../apps/server
