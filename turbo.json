{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@charpentier/server#build": {
      "dependsOn": ["^build", "@charpentier/web#build"],
      "outputs": ["dist/**"]
    }
  }
}
