{
  "name": "charpentier",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "pnpm --filter @charpentier/web dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "check:guards": "node scripts/guard-selftest.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:guards && pnpm check:licenses",
    "dev:desktop": "pnpm --filter @charpentier/desktop dev",
    "test:desktop": "pnpm --filter @charpentier/desktop test:e2e",
    "package:desktop": "pnpm --filter @charpentier/desktop package",
    "package:linux": "pnpm --filter @charpentier/desktop package:linux",
    "test:llm": "vitest run packages/platform-desktop/src/main/compagnon.live.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
